# ─── Database ────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string
# Get this from: https://console.neon.tech → your project → Connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Required: The canonical URL of your app.
#   Local dev  → http://localhost:3000
#   Codespaces → https://<your-codespace>.app.github.dev
#   Production → https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# Required: A random secret used to sign JWT tokens.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"
