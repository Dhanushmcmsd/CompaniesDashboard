# Copy this file to .env.local for local development (Next.js reads .env.local, not .env alone).
# Use the pooled connection string from Neon Console (host contains -pooler).
# Do not add channel_binding=require — it breaks some Windows dev setups.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
GOLD_RATE_PER_GRAM=9500