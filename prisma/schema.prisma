generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Gold Loan — KPI Snapshot
// ─────────────────────────────────────────────────────────────────────────────
model GoldLoanSnapshot {
  id            String   @id @default(cuid())
  uploadBatchId String   @unique
  company       String
  reportDate    DateTime?
  snapshotDate  DateTime @default(now())

  totalAUM              Float
  totalAccounts         Int
  totalCustomers        Int
  avgTicketSize         Float
  avgYield              Float
  totalGoldWeight       Float
  avgGoldWeightPerLoan  Float
  avgLTV                Float
  avgPresentRate        Float
  avgGoldValuePerLoan   Float
  newDisbursements      Float
  mtdDisbursements      Float
  ytdDisbursements      Float

  gnpaAmount            Float
  gnpaPct               Float
  nnpaPct               Float

  totalOverdue          Float
  overdueCollection     Float
  collectionEfficiency  Float
  overduePercent        Float
  overdueAccountNumbers Json?

  bucket0to30           Float
  bucket31to60          Float
  bucket61to90          Float
  bucket90plus          Float

  branchAUM             Json
  productAUM            Json
  branchDisbursement    Json
  branchNPA             Json
  branchGoldWeight      Json

  highLTVAccounts       Int
  goldValueMismatch     Int
  auctionCases          Int

  createdAt DateTime @default(now())

  @@index([company, snapshotDate])
  @@map("gold_loan_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────────
// MF (Micro Finance) Loan — KPI Snapshot
// ─────────────────────────────────────────────────────────────────────────────
model MfLoanSnapshot {
  id            String    @id @default(cuid())
  uploadBatchId String    @unique
  company       String
  reportDate    DateTime?
  snapshotDate  DateTime  @default(now())

  totalAUM          Float
  totalCustomers    Int
  avgYield          Float

  mtdDisbursement   Float
  ftdDisbursement   Float

  overdueAccounts   Int
  overdueAmount     Float

  gnpaAmount        Float
  gnpaPct           Float

  loanClosureAmount Float

  ftdCollection      Float
  mtdCollection      Float
  ftdDisburseFromTxn Float

  branchAUM         Json

  createdAt DateTime @default(now())

  @@index([company, snapshotDate])
  @@map("mf_loan_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────────
// Upload Batch
// ─────────────────────────────────────────────────────────────────────────────
model UploadBatch {
  id           String    @id @default(cuid())
  company      String
  portfolio    String
  fileType     String
  originalName String
  reportDate   DateTime?
  uploadedBy   String
  uploadedAt   DateTime  @default(now())
  rowCount     Int       @default(0)
  status       String    @default("pending")
  errors       Json?

  @@map("upload_batches")
}

enum Role {
  PENDING
  EMPLOYEE
  MANAGEMENT
  ADMIN
}

model User {
  id         String          @id @default(cuid())
  name       String
  email      String          @unique
  password   String
  role       Role            @default(PENDING)
  company    String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  approvedAt DateTime?
  approvedBy String?
  requests   AccessRequest[]

  @@map("users")
}

model AccessRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  requestedAt DateTime @default(now())
  status      String   @default("pending")
  company     String
  note        String?
  reviewedAt  DateTime?
  reviewedBy  String?

  @@map("access_requests")
}
