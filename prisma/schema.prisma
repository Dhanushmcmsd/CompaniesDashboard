// This is your Prisma schema file.
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Gold Loan — KPI Snapshot
// Stores the fully calculated dashboard metrics per upload.
// Raw Excel rows are NEVER stored — all calculations happen in-memory.
// ─────────────────────────────────────────────────────────────────────────────
model GoldLoanSnapshot {
  id            String   @id @default(cuid())
  uploadBatchId String   @unique
  company       String
  reportDate    DateTime?

  // ── Executive Summary ─────────────────────────────────────────────────────
  totalAUM              Float   // SUM(closingBalance)
  totalAccounts         Int     // COUNT(loanAccountNumber)
  totalCustomers        Int     // COUNT DISTINCT customerId
  avgTicketSize         Float   // totalAUM / totalAccounts
  avgYield              Float   // AVG(interestRate)
  totalGoldWeight       Float   // SUM(goldWeight)
  avgGoldWeightPerLoan  Float   // totalGoldWeight / totalAccounts
  avgLTV                Float   // AVG(closingBalance / (goldWeight * presentRate) * 100)
  avgPresentRate        Float   // AVG(presentRate)
  avgGoldValuePerLoan   Float   // AVG(goldWeight * presentRate)
  newDisbursements      Float   // SUM(disbursedAmount) for today's disbursementDate
  mtdDisbursements      Float   // SUM(disbursedAmount) for current month
  ytdDisbursements      Float   // SUM(disbursedAmount) for current year

  // ── NPA & Risk ────────────────────────────────────────────────────────────
  gnpaAmount            Float   // SUM(closingBalance WHERE dpd > 90)
  gnpaPct               Float   // gnpaAmount / totalAUM * 100
  nnpaPct               Float   // gnpaPct * 0.65 (approx until NNPA source available)

  // ── Overdue & Collection ──────────────────────────────────────────────────
  totalOverdue          Float   // SUM(closingBalance WHERE dpd > 0)
  overdueCollection     Float   // SUM(principalCr + interestRcvd WHERE dpd > 0)
  collectionEfficiency  Float   // overdueCollection / totalOverdue * 100
  overduePercent        Float   // totalOverdue / totalAUM * 100

  // ── DPD Buckets ───────────────────────────────────────────────────────────
  bucket0to30           Float   // SUM(closingBalance WHERE dpd 1-30)
  bucket31to60          Float   // SUM(closingBalance WHERE dpd 31-60)
  bucket61to90          Float   // SUM(closingBalance WHERE dpd 61-90)
  bucket90plus          Float   // SUM(closingBalance WHERE dpd > 90)

  // ── Branch & Product breakdown (stored as JSON) ───────────────────────────
  branchAUM             Json    // [{branch, aum, accounts}]
  productAUM            Json    // [{scheme, aum, accounts}]
  branchDisbursement    Json    // [{branch, ftd, mtd, ytd}]
  branchNPA             Json    // [{branch, gnpaAmount, gnpaPct}]
  branchGoldWeight      Json    // [{branch, totalGoldWeight, avgPerLoan}]

  // ── Alerts ────────────────────────────────────────────────────────────────
  highLTVAccounts       Int     // COUNT WHERE (closingBalance / (goldWeight * presentRate)) > 0.85
  goldValueMismatch     Int     // COUNT WHERE closingBalance > (goldWeight * presentRate)
  auctionCases          Int     // COUNT WHERE dpd > 90 (proxy)

  createdAt DateTime @default(now())

  @@map("gold_loan_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────────
// Upload Batch — tracks every file upload attempt
// ─────────────────────────────────────────────────────────────────────────────
model UploadBatch {
  id           String    @id @default(cuid())
  company      String
  portfolio    String
  fileType     String
  originalName String
  reportDate   DateTime?
  uploadedBy   String
  uploadedAt   DateTime  @default(now())
  rowCount     Int       @default(0)
  status       String    @default("pending") // pending | done | error
  errors       Json?

  @@map("upload_batches")
}

// ─────────────────────────────────────────────────────────────────────────────
// Users & Auth (unchanged)
// ─────────────────────────────────────────────────────────────────────────────
enum Role {
  PENDING
  EMPLOYEE
  MANAGEMENT
  ADMIN
}

model User {
  id         String          @id @default(cuid())
  name       String
  email      String          @unique
  password   String
  role       Role            @default(PENDING)
  company    String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  approvedAt DateTime?
  approvedBy String?
  requests   AccessRequest[]

  @@map("users")
}

model AccessRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  requestedAt DateTime @default(now())
  status      String   @default("pending")
  company     String
  note        String?
  reviewedAt  DateTime?
  reviewedBy  String?

  @@map("access_requests")
}
