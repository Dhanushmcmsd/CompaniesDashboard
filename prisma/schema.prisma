// This is your Prisma schema file.
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Gold Loan — Loan Balance Statement
// ─────────────────────────────────────────────
model GoldLoanBalance {
  id                String    @id @default(cuid())
  loanAccountNumber String    @unique
  customerId        String?
  branchName        String?
  branchState       String?
  branchRegion      String?
  schemeName        String?
  disbursementDate  DateTime?
  maturityDate      DateTime?
  closureDate       DateTime?
  closureReason     String?
  closingBalance    Float?
  totalOutstanding  Float?
  goldWeight        Float?
  goldPurity        Float?
  interestRate      Float?
  presentRate       Float?
  dpd               Int?
  principalCr       Float?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("gold_loan_balance")
}

// ─────────────────────────────────────────────
// Gold Loan — Transaction Statement
// ─────────────────────────────────────────────
model GoldLoanTransaction {
  id                   String   @id @default(cuid())
  loanAccountNumber    String
  transactionDate      DateTime
  principalReceived    Float?
  interestReceived     Float?
  otherCharges         Float?
  totalAmountReceived  Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([loanAccountNumber])
  @@index([transactionDate])
  @@map("gold_loan_transaction")
}

enum Role {
  PENDING
  EMPLOYEE
  MANAGEMENT
  ADMIN
}

model User {
  id         String          @id @default(cuid())
  name       String
  email      String          @unique
  password   String
  role       Role            @default(PENDING)
  company    String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  approvedAt DateTime?
  approvedBy String?
  requests   AccessRequest[]

  @@map("users")
}

model AccessRequest {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  requestedAt DateTime @default(now())
  status     String   @default("pending")
  company    String
  note       String?
  reviewedAt DateTime?
  reviewedBy String?

  @@map("access_requests")
}
