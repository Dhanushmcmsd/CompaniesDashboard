// This is your Prisma schema file.
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Gold Loan — Loan Balance Statement
// ─────────────────────────────────────────────
model GoldLoanBalance {
  id                String    @id @default(cuid())
  loanAccountNumber String    @unique
  customerId        String?
  customerName      String?
  branchName        String?
  branchCode        String?
  branchState       String?
  branchRegion      String?
  schemeName        String?
  schemeCode        String?
  inventoryNo       String?
  disbursementDate  DateTime?
  inventoryDate     DateTime?
  intCollectedUpto  DateTime?
  maturityDate      DateTime?
  closureDate       DateTime?
  closureReason     String?
  referenceNo       String?
  fullyReceived     String?
  loanPeriodType    String?
  noticeLetter      String?
  isOnline          String?
  isLocked          String?
  lockedBy          String?
  mktExecCode       String?
  mktExec           String?
  relExecCode       String?
  relExec           String?
  collExecCode      String?
  collExec          String?
  renewedFrom       String?
  uploadBatchId     String?
  reportDate        DateTime?
  openingBalance    Float?
  principalDr       Float?
  closingBalance    Float?
  disbursedAmount   Float?
  totalInterestDue  Float?
  totalOutstanding  Float?
  goldWeight        Float?
  grossWt           Float?
  deductions        Float?
  goldPurity        Float?
  interestRate      Float?
  presentRate       Float?
  dpd               Int?
  interestRcvd      Float?
  interestRcvDuring Float?
  otherChargesDue   Float?
  partialPrinRcvd   Float?
  balPrinRcvd       Float?
  baseInterestDue   Float?
  other1Due         Float?
  other2Due         Float?
  other3Due         Float?
  loanPeriod        Int?
  loanAvailedDays   Int?
  daysPostIntr      Int?
  balDaysToMature   Int?
  principalCr       Float?
  discountAmt       Float?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("gold_loan_balance")
}

// ─────────────────────────────────────────────
// Gold Loan — Transaction Statement
// ─────────────────────────────────────────────
model GoldLoanTransaction {
  id                   String   @id @default(cuid())
  loanAccountNumber    String
  transactionDate      DateTime
  principalReceived    Float?
  interestReceived     Float?
  principalInterestReceived Float?
  otherCharges         Float?
  totalAmountReceived  Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([loanAccountNumber])
  @@index([transactionDate])
  @@map("gold_loan_transaction")
}

model UploadBatch {
  id           String   @id @default(cuid())
  company      String
  portfolio    String
  fileType     String
  originalName String
  reportDate   DateTime?
  uploadedBy   String
  uploadedAt   DateTime @default(now())
  rowCount     Int      @default(0)
  inserted     Int      @default(0)
  updated      Int      @default(0)
  errors       Json?

  @@map("upload_batches")
}

enum Role {
  PENDING
  EMPLOYEE
  MANAGEMENT
  ADMIN
}

model User {
  id         String          @id @default(cuid())
  name       String
  email      String          @unique
  password   String
  role       Role            @default(PENDING)
  company    String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  approvedAt DateTime?
  approvedBy String?
  requests   AccessRequest[]

  @@map("users")
}

model AccessRequest {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  requestedAt DateTime @default(now())
  status     String   @default("pending")
  company    String
  note       String?
  reviewedAt DateTime?
  reviewedBy String?

  @@map("access_requests")
}
