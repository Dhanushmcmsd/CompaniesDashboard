generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Gold Loan — KPI Snapshot
// One snapshot is saved per upload. Each upload is tagged with snapshotDate
// (the date the file was uploaded = FTD day). All period queries filter by date.
// ─────────────────────────────────────────────────────────────────────────────
model GoldLoanSnapshot {
  id            String   @id @default(cuid())
  uploadBatchId String   @unique
  company       String
  reportDate    DateTime?
  // Date the file was uploaded — used for FTD/MTD/YTD period filtering
  snapshotDate  DateTime @default(now())

  // ── Executive Summary ────────────────────────────────────────────────────────
  totalAUM              Float
  totalAccounts         Int
  totalCustomers        Int
  avgTicketSize         Float
  avgYield              Float
  totalGoldWeight       Float
  avgGoldWeightPerLoan  Float
  avgLTV                Float
  avgPresentRate        Float
  avgGoldValuePerLoan   Float
  newDisbursements      Float   // FTD: disbursed on snapshotDate
  mtdDisbursements      Float   // MTD: disbursed in snapshotDate's month
  ytdDisbursements      Float   // YTD: disbursed in snapshotDate's year

  // ── NPA & Risk ──────────────────────────────────────────────────────────────────
  gnpaAmount            Float
  gnpaPct               Float
  nnpaPct               Float

  // ── Overdue & Collection ───────────────────────────────────────────────────────
  totalOverdue          Float
  overdueCollection     Float
  collectionEfficiency  Float
  overduePercent        Float
  /// string[] — loanAccountNumbers where DPD > 0 at time of snapshot.
  /// Used to cross-reference the transaction statement for accurate
  /// overdueCollection when the transaction file is uploaded separately.
  overdueAccountNumbers Json?   // string[]

  // ── DPD Buckets ────────────────────────────────────────────────────────────────
  bucket0to30           Float
  bucket31to60          Float
  bucket61to90          Float
  bucket90plus          Float

  // ── Branch & Product breakdown (JSON) ─────────────────────────────────────────
  branchAUM             Json    // [{branch, aum, accounts}]
  productAUM            Json    // [{scheme, aum, accounts}]
  branchDisbursement    Json    // [{branch, ftd, mtd, ytd}]
  branchNPA             Json    // [{branch, gnpaAmount, gnpaPct}]
  branchGoldWeight      Json    // [{branch, totalGoldWeight, avgPerLoan}]

  // ── Alerts ────────────────────────────────────────────────────────────────────
  highLTVAccounts       Int
  goldValueMismatch     Int
  auctionCases          Int

  createdAt DateTime @default(now())

  @@index([company, snapshotDate])
  @@map("gold_loan_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────────
// MF (Micro Finance) Loan — KPI Snapshot
// Source A: Loan Balance Statement  |  Source B: Transaction Statement
//
// Calculations per workflow spec:
//   totalAUM          = SUM(Principal Closing Balance)
//   totalCustomers    = COUNT DISTINCT(Customer Number)
//   avgYield          = AVG(Rate of Interest)
//   mtdDisbursement   = SUM(Disbursed Amount) WHERE Issue Date >= Apr 1 AND <= snapshotDate
//   ftdDisbursement   = SUM(Disbursed Amount) WHERE Issue Date = snapshotDate
//   overdueAccounts   = COUNT WHERE DPD > 0
//   overdueAmount     = SUM(Principal Closing Balance) WHERE DPD > 0
//   gnpaAmount        = SUM(Principal Closing Balance) WHERE DPD > 90
//   gnpaPct           = gnpaAmount / totalAUM * 100
//   loanClosureAmount = SUM(Closing Principal Received) WHERE Closed On = snapshotDate
//   ftdCollection     = SUM(Total Received) WHERE Transaction Date = snapshotDate [Txn Statement]
//   mtdCollection     = SUM(Total Received) WHERE Transaction Date in current month [Txn Statement]
//   ftdDisburseFromTxn= SUM(Principal Dr) WHERE Transaction Date = snapshotDate [Txn Statement]
// ─────────────────────────────────────────────────────────────────────────────
model MfLoanSnapshot {
  id            String    @id @default(cuid())
  uploadBatchId String    @unique
  company       String
  reportDate    DateTime?
  snapshotDate  DateTime  @default(now())

  // ── Total AUM (from Balance Statement) ──────────────────────────────────────
  totalAUM          Float
  totalCustomers    Int
  avgYield          Float   // AVG(Rate of Interest)

  // ── Disbursement (Balance Statement — Issue Date filter) ─────────────────────
  mtdDisbursement   Float   // Apr 1 to snapshotDate
  ftdDisbursement   Float   // Issue Date = snapshotDate

  // ── Overdue (DPD > 0) ────────────────────────────────────────────────────────
  overdueAccounts   Int
  overdueAmount     Float

  // ── GNPA (DPD > 90) ──────────────────────────────────────────────────────────
  gnpaAmount        Float
  gnpaPct           Float

  // ── Loan Closures ────────────────────────────────────────────────────────────
  loanClosureAmount Float   // SUM(Closing Principal Received) WHERE Closed On = snapshotDate

  // ── Collections (Transaction Statement) ──────────────────────────────────────
  ftdCollection      Float  // SUM(Total Received) WHERE Txn Date = snapshotDate
  mtdCollection      Float  // SUM(Total Received) WHERE Txn Date in current month
  ftdDisburseFromTxn Float  // SUM(Principal Dr) WHERE Txn Date = snapshotDate

  // ── Branch breakdown (JSON) ──────────────────────────────────────────────────
  branchAUM         Json    // [{branch, aum, customers, overdueAmount, gnpaAmount}]

  createdAt DateTime @default(now())

  @@index([company, snapshotDate])
  @@map("mf_loan_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────────
// Upload Batch
// ─────────────────────────────────────────────────────────────────────────────
model UploadBatch {
  id           String    @id @default(cuid())
  company      String
  portfolio    String
  fileType     String
  originalName String
  reportDate   DateTime?
  uploadedBy   String
  uploadedAt   DateTime  @default(now())
  rowCount     Int       @default(0)
  status       String    @default("pending")
  errors       Json?

  @@map("upload_batches")
}

enum Role {
  PENDING
  EMPLOYEE
  MANAGEMENT
  ADMIN
}

model User {
  id         String          @id @default(cuid())
  name       String
  email      String          @unique
  password   String
  role       Role            @default(PENDING)
  company    String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  approvedAt DateTime?
  approvedBy String?
  requests   AccessRequest[]

  @@map("users")
}

model AccessRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  requestedAt DateTime @default(now())
  status      String   @default("pending")
  company     String
  note        String?
  reviewedAt  DateTime?
  reviewedBy  String?

  @@map("access_requests")
}
